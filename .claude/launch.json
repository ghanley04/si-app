{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const http=require('http'),fs=require('fs'),path=require('path'),root=process.cwd();http.createServer((q,s)=>{let u=q.url.split('?')[0];if(u==='/')u='/demo.html';let f=path.join(root,u);fs.readFile(f,(e,d)=>{if(e){s.statusCode=404;s.end('not found');}else{s.setHeader('content-type',u.endsWith('.html')?'text/html':'text/plain');s.end(d);}});}).listen(8123,()=>console.log('serving on 8123'));"],
      "port": 8123
    }
  ]
}
