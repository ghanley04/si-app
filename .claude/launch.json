{
  "version": "0.0.1",
  "autoPort": true,
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const http=require('http'),fs=require('fs'),path=require('path'),root=process.cwd(),port=process.env.PORT||8123;http.createServer((q,s)=>{let u=q.url.split('?')[0];if(u==='/')u='/demo.html';let f=path.join(root,u);fs.readFile(f,(e,d)=>{s.setHeader('Cache-Control','no-store, no-cache, must-revalidate');if(e){s.statusCode=404;s.end('not found');}else{s.setHeader('content-type',u.endsWith('.html')?'text/html':'text/plain');s.end(d);}});}).listen(port,()=>console.log('serving on '+port));"],
      "port": 8150
    }
  ]
}
